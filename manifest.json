{
  "manifest_version": 3,
  "name": "Cube Capo",
  "version": "1.0.0",
  "description": "Transposes Rubik's cube scrambles for ergonomics, injecting details directly into cubing timers like csTimer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cube-capo@example.com"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "Cube Capo"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extension/contentLauncher.js"],
      "css": ["extension/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extension/content.js",
        "shared/ui/dom.js",
        "shared/ui/stats.js",
        "shared/cube/defaults.js",
        "shared/cube/scramble.js",
        "shared/cube/move.js",
        "shared/cube/util.js",
        "shared/types.js",
        "extension/content.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
