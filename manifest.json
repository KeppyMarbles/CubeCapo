{
  "manifest_version": 3,
  "name": "Scramble Manipulator",
  "version": "1.0.0",
  "description": "Optimizes Rubik's cube scrambles for ergonomics, injecting details directly into cubing timers like csTimer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "scramble-manipulator@example.com"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "Scramble Manipulator"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/ui/breakdownTable.js", "extension/content.js"],
      "css": ["extension/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/stats.js",
        "src/data/gripTransitions.json",
        "src/cube/scramble.js",
        "src/cube/move.js",
        "src/types.js",
        "extension/content.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
